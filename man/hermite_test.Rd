\subsection{The complete profile test (\code{test = "complete"})}{
All five contrasts -- \eqn{\Delta\mu} (studentized), \eqn{\Delta\mathrm{Med}}
(studentized), \eqn{\Delta\log\sigma}, \eqn{\Delta c_2}, \eqn{\Delta c_3} --
