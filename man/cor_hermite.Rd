x <- rnorm(n, mean = 100, sd = 15)           # Normally distributed
y <- exp(0.5 * z + rnorm(n, sd = 0.5))        # Skewed lognormal latency

# Compute r_HM with 95\% Fisher-z CI
r_fit <- cor_hermite(x, y, conf_level = 0.95, ci_method = "fisher")
